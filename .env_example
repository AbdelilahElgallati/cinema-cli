TMDB_API_KEY=
PORT=3010
BACKEND_URL=http://127.0.0.1:3010
OPENSUBTITLES_API_KEY=
DISABLE_CACHE=false
SUBDL_API_KEY=

# VidRock provider decryption passphrase (required if VidRock is enabled)
VIDROCK_PASSPHRASE=

# Show Node.js backend logs in the terminal during startup (true/false)
# Default: false — backend runs silently in background
AUTO_START_BACKEND_SHOW_LOGS=false

# Maximum number of concurrent downloads (default: 3)
MAX_CONCURRENT_DOWNLOADS=3

# Max concurrent source fetches during batch downloads (default: 3)
MAX_CONCURRENT_SOURCE_FETCHES=3
